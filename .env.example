# =============================================================================
# n8n-hubspot-custom-code-action-error-handler: environment template
# -----------------------------------------------------------------------------
# Copy to .env (never commit it), replace every REPLACE_WITH_... value and load
# it into the n8n process. Code nodes and expressions must be allowed to read
# environment variables:   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#
# API keys are NOT read from this file by the workflow's Code nodes. Create them as
# n8n credentials and select them on the nodes after import:
#   HubSpot App Token credential ...... REPLACE_WITH_HUBSPOT_PAT
#   Header Auth credential (Datadog) .. name: DD-API-KEY   value: REPLACE_WITH_DATADOG_API_KEY
#
# HubSpot custom code secrets (set in HubSpot, not here):
#   N8N_ERROR_WEBHOOK_URL ...... REPLACE_WITH_N8N_ERROR_WEBHOOK_URL
#   N8N_ERROR_WEBHOOK_SECRET ... same value as ERROR_WEBHOOK_SECRET below
#
# DISCLAIMER: provided "AS IS" without warranty. See DISCLAIMER.md.
# =============================================================================

# --- Safety ------------------------------------------------------------------
# true  = parse and classify, but only LOG planned alerts, logs and recovery actions
# false = live: post to Slack, ship logs to Datadog, update HubSpot records, create tasks
SANDBOX_MODE=true

# --- Inbound webhook authentication -------------------------------------------
# Shared secret sent by HubSpot in the x-hs-error-secret header (min 16 characters).
ERROR_WEBHOOK_SECRET=REPLACE_WITH_ERROR_WEBHOOK_SECRET

# --- HubSpot -----------------------------------------------------------------
# Numeric portal ID for record links (falls back to the portalId in each payload).
HUBSPOT_PORTAL_ID=REPLACE_WITH_HUBSPOT_PORTAL_ID
HUBSPOT_APP_BASE_URL=https://app.hubspot.com

# --- Retry / fallback --------------------------------------------------------
ENABLE_RETRY=true
# Maximum automatic retries per record before falling back (0-10).
MAX_RETRIES=3
# Backoff: base x 2^attempt seconds (+ up to 20% jitter), capped at the max.
RETRY_BASE_DELAY_SECONDS=60
RETRY_MAX_DELAY_SECONDS=900
ENABLE_FALLBACK=true
# Create a HubSpot task on the failed record when falling back.
ENABLE_FALLBACK_TASK=true
# Owner ID for fallback tasks (blank = unassigned).
FALLBACK_OWNER_ID=
# Task association type IDs per object type (HubSpot-defined defaults; verify for your portal).
TASK_ASSOCIATION_TYPE_IDS_JSON={"contacts":204,"companies":192,"deals":216,"tickets":228}

# --- Slack alerts ------------------------------------------------------------
ENABLE_SLACK=true
SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK_URL
# Optional separate channel for critical errors (AUTH, CODE). Blank = use SLACK_WEBHOOK_URL.
SLACK_CRITICAL_WEBHOOK_URL=REPLACE_WITH_SLACK_CRITICAL_WEBHOOK_URL
# info | warning | error | critical
ALERT_MIN_SEVERITY=warning
# Suppress repeat alerts with the same fingerprint for this many minutes (0 = never suppress).
ALERT_DEDUPE_MINUTES=30

# --- Datadog / console logging ----------------------------------------------
# false = structured JSON lines on the n8n process stdout (Console Logger node).
ENABLE_DATADOG=false
# datadoghq.com | us3.datadoghq.com | us5.datadoghq.com | datadoghq.eu | ap1.datadoghq.com | ddog-gov.com
DATADOG_SITE=datadoghq.com
DATADOG_SERVICE=hubspot-custom-code
DATADOG_ENV=production

# --- Limits ------------------------------------------------------------------
MAX_EVENTS_PER_REQUEST=50
MAX_STACK_FRAMES=15
